APP_NAME="Toro GYM Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.com
TRUSTED_PROXIES=

DUCKDNS_TOKEN=
DUCKDNS_DOMAIN=your-staging-subdomain

OWNER_NAME="Toro Staging"
OWNER_EMAIL=staging@example.com
OWNER_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=gymie_staging
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

REVERB_APP_ID=your-reverb-app-id
REVERB_APP_KEY=your-reverb-app-key
REVERB_APP_SECRET=
REVERB_HOST=staging.example.com
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

HTTP_PORT=8080
HTTPS_PORT=8444

QR_BASE_URL=https://staging.example.com
FUNNEL_HOST=
LETSENCRYPT_EMAIL=staging@example.com
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=gymie_staging
